{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src", "scripts/validate.ts", "tests"]
}
